  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "filter.d.ts",
    "filter.js",
    "cli.js",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@types/mdast": "^3.0.0",
    "@types/nlcst": "^1.0.0",
    "meow": "^11.0.0",
    "rehype-parse": "^8.0.0",
    "rehype-retext": "^3.0.0",
    "remark-frontmatter": "^4.0.0",
    "remark-gfm": "^3.0.0",
    "remark-mdx": "2.0.0",
    "remark-message-control": "^7.0.0",
    "remark-parse": "^10.0.0",
    "remark-retext": "^5.0.0",
    "retext-english": "^4.0.0",
    "retext-equality": "~6.6.0",
    "retext-profanities": "~7.2.0",
    "unified": "^10.0.0",
    "update-notifier": "^6.0.0",
    "vfile": "^5.0.0",
    "vfile-reporter": "^7.0.0",
    "vfile-sort": "^3.0.0",
    "@stackline/unified-engine": "1.0.0",
    "@stackline/unified-diff": "1.0.1",
    "supports-color": "^10.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "tape": "^5.10.2",
    "typescript": "^7.0.2",
    "vfile-reporter-json": "^3.3.0"
  },
  "scripts": {
    "build": "node scripts/check-artifacts.js",
    "lint": "eslint cli.js index.js filter.js test/ignore.test.js scripts/*.js",
    "test-api": "node test/index.js",
    "test": "npm run test-api && node --test test/ignore.test.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prepack": "npm run build"
  },
  "alex": {
    "allow": [
      "butt"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "semi": false,
    "trailingComma": "none"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
